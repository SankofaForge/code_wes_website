{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code_Wes event",
  "description": "One file per past event in content/events/. The file name is the page URL: content/events/weshack-2024.json becomes /events/weshack-2024/. Every event also appears on /log as a tagged commit.",
  "type": "object",
  "required": ["name", "date", "kind", "summary"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Such as \"WesHack 2024\"." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day it started, YYYY-MM-DD." },
    "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "For events longer than a day." },
    "kind": { "enum": ["hackathon", "workshop", "talk", "social", "other"] },
    "place": { "type": "string", "description": "Such as \"Exley Science Center\"." },
    "summary": { "type": "string", "description": "What happened, in two or three sentences." },
    "attendance": { "type": "integer", "minimum": 1, "description": "Roughly how many people came. Leave it out if nobody counted." },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "about": { "type": "string" }
        }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 8,
      "description": "Put images in public/events/ (WebP or JPEG, under 300 KB each).",
      "items": {
        "type": "object",
        "required": ["src", "alt", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string", "pattern": "^/events/" },
          "alt": { "type": "string", "minLength": 8 },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "description": "Such as \"Devpost\" or \"Repository\"." },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
